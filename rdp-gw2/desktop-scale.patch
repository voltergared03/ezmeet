 }
 
+/**
+ * Returns the deviceScaleFactor to pair with the given desktopScaleFactor, per
+ * MS-RDPBCGR 2.2.1.3.2 (only 100, 140, or 180 are legal; an invalid value makes
+ * the server discard desktopScaleFactor too).
+ */
+static int guac_rdp_device_scale_for_disp(int desktop_scale, int height) {
+
+    if (desktop_scale >= 200 && height > 1382)
+        return 180;
+
+    if (desktop_scale >= 125)
+        return 140;
+
+    return 100;
+
+}
+
