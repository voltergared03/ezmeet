+ */
+static int guac_rdp_device_scale(int desktop_scale, int height) {
+
+    if (desktop_scale >= 200 && height > 1382)
+        return 180;
+
+    if (desktop_scale >= 125)
+        return 140;
+
+    return 100;
+
+}
