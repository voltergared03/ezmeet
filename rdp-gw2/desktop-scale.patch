-            .DeviceScaleFactor = 0
+            /* Upstream hardcodes 0 here, which is out of range and makes Windows
+             * discard the scale negotiated at connect time on every resize. */
+            .DesktopScaleFactor = settings->desktop_scale,
+            .DeviceScaleFactor = guac_rdp_device_scale_for_disp(
+                    settings->desktop_scale, height)
         }};
 
